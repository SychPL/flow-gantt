{
  "name": "@sychpl/flow-gantt",
  "version": "0.1.2",
  "description": "React Gantt-style chart for dependency flows: tree grid, dependency-driven bar layout and connectors.",
  "author": "SychPL",
  "homepage": "https://github.com/SychPL/flow-gantt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SychPL/flow-gantt.git"
  },
  "bugs": {
    "url": "https://github.com/SychPL/flow-gantt/issues"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "gantt",
    "timeline",
    "dependencies",
    "flow",
    "chart",
    "accessible"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/types/layout/index.d.ts",
      "import": "./dist/layout.js"
    },
    "./ops": {
      "types": "./dist/types/ops/index.d.ts",
      "import": "./dist/ops.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.28.12",
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:react18": "vitest run --config vitest.react18.config.ts",
    "test:e2e": "playwright test",
    "demo": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "demo:preview": "vite preview --config vite.demo.config.ts --port 4180 --strictPort",
    "bench": "node scripts/bench-layout.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
